{
    "manifest_version": 3,
    "name": "StorageNinja",
    "version": "2.0.0",
    "description": "Copy, paste and manage Local Storage, Session Storage, Cookies, IndexedDB and Cache Storage of the active tab.",
    "minimum_chrome_version": "116",
    "permissions": [
        "activeTab",
        "storage",
        "unlimitedStorage",
        "cookies",
        "scripting",
        "contextMenus",
        "browsingData",
        "offscreen",
        "clipboardRead",
        "clipboardWrite"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "StorageNinja",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "devtools_page": "devtools.html",
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+S"
            },
            "description": "Open StorageNinja"
        },
        "copy-token": {
            "suggested_key": {
                "default": "Alt+Shift+T"
            },
            "description": "Copy the access token of the current page"
        }
    }
}
